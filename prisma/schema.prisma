generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SELLER
  BUYER
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  UNDER_REVIEW
  PENDING
  SOLD
  ARCHIVED
}

enum AssetType {
  RESIDENTIAL
  COMMERCIAL
  CONSUMER
  MIXED
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  COUNTERED
}

enum NotificationType {
  NEW_BID
  BID_ACCEPTED
  BID_REJECTED
  NEW_MESSAGE
  LISTING_SAVED
  LISTING_PUBLISHED
  COUNTER_OFFER
}

enum LienPosition {
  SENIOR
  JUNIOR
}

enum NdaStatus {
  NONE
  PENDING
  SIGNED
}

enum DealStage {
  REVIEWING
  BIDDING
  UNDER_LOI
  CLOSING
  CLOSED
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String?
  passwordHash   String?
  company        String?
  phone          String?
  role           UserRole       @default(SELLER)
  approvalStatus ApprovalStatus @default(PENDING)
  approvedAt     DateTime?
  approvedBy     String?
  profileImage   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Investor / buyer profile fields
  lastName              String?
  entityName            String?
  signerTitle           String?
  addressStreet         String?
  addressCity           String?
  addressState          String?
  addressZip            String?
  directPhone           String?
  officePhone           String?
  yearsExperience       Int?
  investorType          String?   // Private Investor, Fund Manager, Partner
  lienPosition          String?   // First Mortgage, Second/HELOC, Both
  loanStatusPref        String?   // Performing, Non-Performing, Both
  mainObjective         String?   // Cash Flow, Quick Payoff/Short Pay, Obtain Real Estate

  // Loan servicer info
  servicerName          String?
  servicerAddress       String?
  servicerContactName   String?
  servicerContactPhone  String?
  servicerContactEmail  String?

  // Role expansion request
  pendingRoleRequest    String?   // 'BUYER' or 'SELLER' — pending admin review

  // Admin-only fields
  adminNotes            String?   // Internal notes, never exposed to the user
  suspendedAt           DateTime?
  suspendedReason       String?

  listings              Listing[]
  sentMessages          Message[]                 @relation("SentMessages")
  receivedMessages      Message[]                 @relation("ReceivedMessages")
  conversations         ConversationParticipant[]
  savedListings         SavedListing[]
  bidsPlaced            Bid[]                     @relation("BidsPlaced")
  notifications         Notification[]
  uploadedDocuments     Document[]                @relation("UploadedDocuments")
  ndasSigned            NdaAgreement[]            @relation("NdasSigned")
  documentDownloads     DocumentDownload[]        @relation("DocumentDownloads")
  auditLogs             AuditLog[]                @relation("AuditLogs")
  savedSearches         SavedSearch[]             @relation("SavedSearches")
  dealPipelines         DealPipeline[]            @relation("DealPipelines")
  notificationPrefs     NotificationPreference?   @relation("NotificationPrefs")
  twoFactorSecret       TwoFactorSecret?          @relation("TwoFactor")
  passwordResets        PasswordResetToken[]      @relation("PasswordResets")

  @@index([email])
  @@index([approvalStatus])
}

model Listing {
  id                String        @id @default(cuid())
  title             String
  description       String?
  assetType         AssetType
  unpaidBalance     Float
  loanCount         Int
  location          String
  zip               String?
  region            String?
  avgDelinquency    Int?
  status            ListingStatus @default(DRAFT)
  documents         String[]
  dropboxLink       String?
  lienPosition         LienPosition?
  askingPrice          Float?
  performanceStatus    String?
  noteType             String?
  listingType          String?
  bidDeadline          DateTime?
  reservePrice         Float?
  preferredClosingDays Int?
  ndaRequired          Boolean?
  createdAt            DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  seller   User   @relation(fields: [sellerId], references: [id])
  sellerId String

  asset             Asset?
  savedBy           SavedListing[]
  bids              Bid[]
  views             ListingView[]
  vaultDocuments    Document[]
  ndaAgreements     NdaAgreement[]
  dueDiligenceItems DueDiligenceChecklist[]
  auditLogs         AuditLog[]
  dealPipelines     DealPipeline[]

  @@index([status])
  @@index([assetType])
  @@index([sellerId])
}

model Asset {
  id        String   @id @default(cuid())
  listingId String   @unique
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // ── LTV Metrics ───────────────────────────────────────────
  ltv         Float?
  cltv        Float?
  payoffCltv  Float?

  // ── Property Data ─────────────────────────────────────────
  fairMarketValue         Float?
  occupancyType           String?
  homePurchaseDate        DateTime?
  homePurchasePrice       Float?
  propertyStreet          String?
  propertyCity            String?
  propertyState           String?
  propertyZip             String?
  propertyType            String?
  county                  String?
  yearBuilt               Int?
  floorSizeSqFt           Float?
  lotSizeSqFt             Float?
  bedrooms                Int?
  bathrooms               Float?
  streetViewUrl           String?
  lastPaymentReceivedDate DateTime?
  paymentAccepted         String?
  isInterestOnly          Boolean?
  interestOnlyPeriod      Int?
  totalMonthlyPayment     Float?
  legalStatus             String?
  isJudicialState         Boolean?

  // ── Bankruptcy — Current ──────────────────────────────────
  isInBankruptcy       Boolean?
  bankruptcyChapter    String?
  bkFilingDate         DateTime?
  ch13PocFilingDate    DateTime?
  bkConfirmationDate   DateTime?
  bkDismissalDate      DateTime?
  ch13DischargedDate   DateTime?

  // ── Bankruptcy — Previous History ─────────────────────────
  ch7PetitionDate       DateTime?
  ch7CaseNumber         String?
  ch7DateFiled          DateTime?
  ch7DismissalDate      DateTime?
  ch7DischargeDate      DateTime?
  prevCh13PetitionDate  DateTime?
  prevCh13CaseNumber    String?
  prevCh13DateFiled     DateTime?
  prevCh13DismissalDate DateTime?
  prevCh13DischargeDate DateTime?

  // ── First Mortgage — Current Loan Data ───────────────────
  firstMtg_loanStatus        String?
  firstMtg_originationDate   DateTime?
  firstMtg_maturityDate      DateTime?
  firstMtg_loanTermMonths    Int?
  firstMtg_firstPaymentDate  DateTime?
  firstMtg_interestPaidToDate DateTime?
  firstMtg_totalMonthsPaid   Int?
  firstMtg_originalAmount    Float?
  firstMtg_currentBalance    Float?
  firstMtg_nextDueDate       DateTime?
  firstMtg_monthsRemaining   Int?
  firstMtg_interestRate      Float?
  firstMtg_monthlyPI         Float?
  firstMtg_monthlyEscrow     Float?

  // ── First Mortgage — Modification Terms ──────────────────
  firstMtg_isModified           Boolean?
  firstMtg_hasBalloon           Boolean?
  firstMtg_balloonDate          DateTime?
  firstMtg_modDate              DateTime?
  firstMtg_modMaturityDate      DateTime?
  firstMtg_modTermMonths        Int?
  firstMtg_modFirstPayDate      DateTime?
  firstMtg_modInterestPaidTo    DateTime?
  firstMtg_modMonthsPaid        Int?
  firstMtg_modPaymentsRemaining Int?
  firstMtg_modLoanAmount        Float?
  firstMtg_modCurrentBalance    Float?
  firstMtg_modDeferredBalance   Float?
  firstMtg_modInterestRate      Float?
  firstMtg_modMonthlyPI         Float?
  firstMtg_modMonthlyEscrow     Float?

  // ── First Mortgage — Foreclosure Status ──────────────────
  firstMtg_foreclosureDefaultDate DateTime?
  firstMtg_foreclosureDefaultAmt  Float?
  firstMtg_foreclosureSaleDate    DateTime?

  // ── Second Mortgage — Current Loan Data ──────────────────
  secondMtg_loanStatus         String?
  secondMtg_originationDate    DateTime?
  secondMtg_maturityDate       DateTime?
  secondMtg_loanTermMonths     Int?
  secondMtg_firstPaymentDate   DateTime?
  secondMtg_interestPaidToDate DateTime?
  secondMtg_totalMonthsPaid    Int?
  secondMtg_originalAmount     Float?
  secondMtg_currentBalance     Float?
  secondMtg_nextDueDate        DateTime?
  secondMtg_monthsRemaining    Int?
  secondMtg_interestRate       Float?
  secondMtg_monthlyPI          Float?
  secondMtg_monthlyEscrow      Float?

  // ── Second Mortgage — Modification Terms ─────────────────
  secondMtg_isModified           Boolean?
  secondMtg_hasBalloon           Boolean?
  secondMtg_balloonDate          DateTime?
  secondMtg_modDate              DateTime?
  secondMtg_modMaturityDate      DateTime?
  secondMtg_modTermMonths        Int?
  secondMtg_modFirstPayDate      DateTime?
  secondMtg_modInterestPaidTo    DateTime?
  secondMtg_modMonthsPaid        Int?
  secondMtg_modPaymentsRemaining Int?
  secondMtg_modLoanAmount        Float?
  secondMtg_modCurrentBalance    Float?
  secondMtg_modDeferredBalance   Float?
  secondMtg_modInterestRate      Float?
  secondMtg_modMonthlyPI         Float?
  secondMtg_modMonthlyEscrow     Float?

  // ── Second Mortgage — Foreclosure Status ─────────────────
  secondMtg_foreclosureDefaultDate DateTime?
  secondMtg_foreclosureDefaultAmt  Float?
  secondMtg_foreclosureSaleDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Conversation {
  id        String   @id @default(cuid())
  listingId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  userId         String
  conversationId String
  lastReadAt     DateTime?

  user         User         @relation(fields: [userId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@unique([userId, conversationId])
}

model Message {
  id             String    @id @default(cuid())
  content        String
  senderId       String
  receiverId     String?
  conversationId String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  sender       User         @relation("SentMessages", fields: [senderId], references: [id])
  receiver     User?        @relation("ReceivedMessages", fields: [receiverId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([senderId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user      User      @relation("PasswordResets", fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model SavedListing {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
}

model Bid {
  id            String    @id @default(cuid())
  listingId     String
  bidderId      String
  amount        Float
  noteRate      Float?
  message       String?
  status        BidStatus @default(PENDING)
  expiresAt     DateTime?
  counterAmount Float?
  counterNote   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidder  User    @relation("BidsPlaced", fields: [bidderId], references: [id])

  @@index([listingId])
  @@index([bidderId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model ListingView {
  id          String   @id @default(cuid())
  listingId   String
  fingerprint String?
  createdAt   DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
  @@index([listingId, fingerprint])
}

model Document {
  id            String   @id @default(cuid())
  listingId     String
  uploaderId    String
  name          String
  storageKey    String
  mimeType      String
  sizeBytes     Int
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())

  listing   Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  uploader  User               @relation("UploadedDocuments", fields: [uploaderId], references: [id])
  downloads DocumentDownload[]

  @@index([listingId])
}

model AdminToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([token])
}

model NdaAgreement {
  id          String    @id @default(cuid())
  listingId   String
  buyerId     String
  signedAt    DateTime  @default(now())
  ipAddress   String?
  userAgent   String?

  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer       User      @relation("NdasSigned", fields: [buyerId], references: [id])

  @@unique([listingId, buyerId])
  @@index([listingId])
  @@index([buyerId])
}

model DocumentDownload {
  id          String   @id @default(cuid())
  documentId  String
  userId      String
  createdAt   DateTime @default(now())

  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user        User     @relation("DocumentDownloads", fields: [userId], references: [id])

  @@index([documentId])
  @@index([userId])
}

model DueDiligenceChecklist {
  id          String    @id @default(cuid())
  listingId   String
  label       String
  completed   Boolean   @default(false)
  completedBy String?
  completedAt DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model AuditLog {
  id          String   @id @default(cuid())
  listingId   String?
  userId      String?
  action      String
  details     String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  listing     Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  user        User?    @relation("AuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([listingId, createdAt])
  @@index([userId, createdAt])
  @@index([action])
}

model SavedSearch {
  id           String    @id @default(cuid())
  userId       String
  name         String
  filters      Json
  alertEnabled Boolean   @default(true)
  lastAlertAt  DateTime?
  createdAt    DateTime  @default(now())

  user         User      @relation("SavedSearches", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DealPipeline {
  id          String    @id @default(cuid())
  userId      String
  listingId   String
  stage       DealStage @default(REVIEWING)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation("DealPipelines", fields: [userId], references: [id], onDelete: Cascade)
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId, stage])
}

model NotificationPreference {
  id               String  @id @default(cuid())
  userId           String  @unique
  newBidInApp      Boolean @default(true)
  newBidEmail      Boolean @default(true)
  bidAcceptedInApp Boolean @default(true)
  bidAcceptedEmail Boolean @default(true)
  bidRejectedInApp Boolean @default(true)
  bidRejectedEmail Boolean @default(false)
  newMessageInApp  Boolean @default(true)
  newMessageEmail  Boolean @default(false)
  digestFrequency  String  @default("instant")

  user             User    @relation("NotificationPrefs", fields: [userId], references: [id], onDelete: Cascade)
}

model TwoFactorSecret {
  id          String   @id @default(cuid())
  userId      String   @unique
  secret      String
  verified    Boolean  @default(false)
  backupCodes String[]
  createdAt   DateTime @default(now())

  user        User     @relation("TwoFactor", fields: [userId], references: [id], onDelete: Cascade)
}
