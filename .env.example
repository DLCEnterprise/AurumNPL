# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/aurum_npl"

# ─── NextAuth / Auth.js ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-32-char-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ─── Admin approval gate ───────────────────────────────────────────────────────
# Email address that receives new-user notifications with approve/reject links
ADMIN_EMAIL="admin@yourdomain.com"
# Used to sign admin JWT tokens — generate with: openssl rand -base64 32
ADMIN_SECRET="replace-with-32-char-random-secret"

# ─── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ─── Rate Limiting (Upstash Redis) ────────────────────────────────────────────
# Optional — if not set, falls back to in-memory rate limiting (dev only)
# Get from: https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ─── Google Maps (Street View) ────────────────────────────────────────────────
# Optional — used for property street view images on asset detail pages
# Get from: https://console.cloud.google.com (Maps Static API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ─── App ──────────────────────────────────────────────────────────────────────
BASE_URL="http://localhost:3000"
NODE_ENV="development"
