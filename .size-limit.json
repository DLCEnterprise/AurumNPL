[
  {
    "name": "Shared JS (first load)",
    "path": ".next/static/chunks/*.js",
    "limit": "250 kB",
    "gzip": true,
    "ignore": ["*.map", "webpack-*.js", "polyfills-*.js"]
  },
  {
    "name": "CSS bundle",
    "path": ".next/static/css/*.css",
    "limit": "30 kB",
    "gzip": true
  },
  {
    "name": "Self-hosted fonts",
    "path": "public/fonts/*.woff2",
    "limit": "100 kB",
    "gzip": false
  }
]
